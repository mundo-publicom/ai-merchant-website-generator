# Enables the "Enhance with AI" buttons on the wizard's long-answer fields.
#
# Copy this file to .env.local. The key is read by the Vite dev-server
# middleware in vite-plugins/enhanceApi.ts - it has no VITE_ prefix, so it is
# never exposed to the browser or included in the production bundle.
# Restart the dev server after changing it.
#
# LOCAL / SERVER ONLY. Never set this in the GitHub Pages build: a static site
# has no server to hold it, so anything the build inlines is public. Put it in
# your serverless platform's environment instead - see the README.
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-5.6.
# OPENAI_MODEL=gpt-5.6

# Optional. For Azure OpenAI, a proxy, or any OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://your-gateway.example.com/v1

# Optional: point the client at a deployed enhancement endpoint instead of the
# dev-server route (this one IS bundled, so it must be a URL, never a key).
# On GitHub Pages set it as a repository *variable*, not a secret.
# VITE_ENHANCE_URL=https://your-function.example.com/api/enhance

# Optional: base path for the production build. The deploy workflow sets this
# to /<repo>/ for GitHub Pages project sites. Use / for a custom domain.
# BASE_PATH=/
